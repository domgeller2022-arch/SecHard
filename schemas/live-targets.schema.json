{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hardening.invalid/schemas/live-targets.schema.json",
  "title": "Approved live-check targets",
  "description": "The explicit inventory of targets a live recipe may contact. A target that is not listed here is not a target, however it was suggested.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "targets"],
  "properties": {
    "schema_version": { "const": "live-targets/v1" },
    "targets": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scheme", "host", "environment", "routes", "approved_redirect_hosts", "requirements"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100 },
          "scheme": { "enum": ["http", "https"] },
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "A hostname or IP literal. Wildcards are not accepted: a wildcard is not an inventory."
          },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "environment": { "enum": ["local", "preview", "staging", "production"] },
          "routes": { "type": "array", "items": { "type": "string", "pattern": "^/", "maxLength": 1024 }, "minItems": 1, "maxItems": 500 },
          "approved_redirect_hosts": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 255 },
            "maxItems": 32,
            "description": "Hosts a response may redirect to without being treated as an unapproved redirect."
          },
          "response_limits": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_bytes": { "type": "integer", "minimum": 1024, "maximum": 104857600 },
              "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 120000 }
            }
          },
          "tls": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required"],
            "properties": {
              "required": {
                "type": "boolean",
                "description": "When true, a missing or invalid certificate blocks. Plain HTTP cannot satisfy this."
              },
              "min_days_valid": { "type": "integer", "minimum": 0, "maximum": 398 }
            }
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["route_prefix"],
              "properties": {
                "route_prefix": { "type": "string", "pattern": "^/" },
                "private": {
                  "type": "boolean",
                  "description": "Responses for matching routes must not be publicly cacheable."
                },
                "required_headers": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name"],
                    "properties": {
                      "name": { "type": "string", "minLength": 1, "maxLength": 100 },
                      "value_contains": { "type": "string", "maxLength": 200 }
                    }
                  }
                },
                "must_not_appear": {
                  "type": "array",
                  "description": "Substrings that must not appear in the response body: stack traces, internal paths, credential material.",
                  "items": { "type": "string", "minLength": 3, "maxLength": 200 },
                  "maxItems": 32
                }
              }
            }
          }
        }
      }
    }
  }
}
