{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hardening.invalid/schemas/standard-mapping.schema.json",
  "title": "Requirement-level standard mapping",
  "description": "Batch S data model: every requirement of a mapped standard is either mapped to controls and recipes with a method, or recorded as a gap with a reason. Nothing is verified_coverage until an application is assessed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "standard_id",
    "edition",
    "relationship",
    "reviewed_by",
    "reviewed_at",
    "requirements"
  ],
  "properties": {
    "schema": {
      "const": "hardening/standard-mapping/v1"
    },
    "standard_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "maxLength": 64
    },
    "edition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "source_data": {
      "type": "string",
      "maxLength": 512,
      "description": "Vendored official data this mapping was checked against, when any."
    },
    "relationship": {
      "enum": [
        "related_risk",
        "verified_coverage"
      ]
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "summary",
          "method",
          "relationship"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "section": {
            "type": "string",
            "maxLength": 64
          },
          "chapter": {
            "type": "string",
            "maxLength": 64
          },
          "summary": {
            "type": "string",
            "minLength": 8,
            "maxLength": 500,
            "description": "SecHard's own paraphrase; the standard's text is not reproduced."
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2,6}-[0-9]{2}$"
            },
            "maxItems": 16
          },
          "recipes": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 128
            },
            "maxItems": 16
          },
          "method": {
            "enum": [
              "automated",
              "manual",
              "advisory",
              "not_applicable",
              "gap"
            ]
          },
          "relationship": {
            "enum": [
              "related_risk",
              "verified_coverage"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 1000
          },
          "url": {
            "type": "string",
            "maxLength": 512,
            "description": "Reference-only link for standards mapped by ID without adapted text (MCP Top 10)."
          }
        }
      }
    }
  }
}
