{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hardening.invalid/schemas/pattern.schema.json",
  "title": "Reviewed security pattern",
  "description": "A reviewed, corrected piece of security guidance linked to control IDs. Patterns feed agent guidance and vulnerable/permitted fixtures. A pattern is a supporting record: it cannot override applicability, approve an exception, or produce execution success.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "related_control_ids",
    "applicability",
    "rationale",
    "limitations",
    "vulnerable_example",
    "permitted_example",
    "verification",
    "provenance",
    "review_status"
  ],
  "properties": {
    "schema_version": { "const": "pattern/v1" },
    "id": { "$ref": "#/$defs/patternId" },
    "review_status": { "enum": ["draft", "reviewed"] },
    "reviewed_by": { "type": "string", "maxLength": 200 },
    "reviewed_at": { "$ref": "#/$defs/timestamp" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "related_control_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(CTX|GOV|AGT|DEP|SEC|CI|CODE|QUAL|AUTH|AUTHZ|DATA|WEB|ABUSE|BIZ|DEPLOY|OPS|PRIV|REL|EXC)-[0-9]{2}$"
      },
      "minItems": 1,
      "maxItems": 16
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule"],
      "properties": {
        "rule": { "enum": ["always", "when_feature_enabled", "when_any_feature_enabled", "when_environment"] },
        "features": {
          "type": "array",
          "items": {
            "enum": [
              "accounts",
              "private_resources",
              "roles",
              "tenancy",
              "recovery",
              "payments",
              "webhooks",
              "uploads",
              "outbound_requests",
              "personal_data",
              "runtime_ai",
              "hosting",
              "interfaces",
              "environments",
              "persistent_storage"
            ]
          },
          "maxItems": 16
        },
        "environments": {
          "type": "array",
          "items": { "enum": ["local", "preview", "staging", "production"] },
          "maxItems": 8
        }
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 20,
      "maxLength": 6000,
      "description": "The reviewed, corrected explanation. Where an upstream source was factually wrong, the correction is stated here rather than carried forward."
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 },
      "minItems": 1,
      "maxItems": 32
    },
    "vulnerable_example": { "$ref": "#/$defs/example" },
    "permitted_example": { "$ref": "#/$defs/example" },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "description"],
        "properties": {
          "method": {
            "enum": [
              "authorization_test",
              "functional_test",
              "static_analysis",
              "schema_validation",
              "policy_consistency",
              "live_http_check",
              "client_asset_inspection",
              "manual_attestation"
            ]
          },
          "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "recipe": { "type": "string", "maxLength": 200 },
          "implemented": {
            "type": "boolean",
            "description": "False until the fixture or recipe actually exists and has run. An unimplemented verification is not evidence."
          }
        }
      },
      "maxItems": 16
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "reviewed_at"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "source_file": { "type": "string", "maxLength": 512 },
        "source_digest": { "$ref": "#/$defs/sha256" },
        "reviewed_at": { "$ref": "#/$defs/timestamp" },
        "corrections": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "maxItems": 16,
          "description": "Each factual correction applied to the upstream material before reuse."
        }
      }
    },
    "extensions": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "review_status": { "const": "reviewed" } }, "required": ["review_status"] },
      "then": { "required": ["reviewed_by", "reviewed_at"] }
    }
  ],
  "$defs": {
    "patternId": {
      "type": "string",
      "pattern": "^PAT-[A-Z]+-[0-9]{2}$",
      "maxLength": 32,
      "description": "A supporting identifier, deliberately not a control ID shape."
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time", "maxLength": 64 },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "code", "explanation"],
      "properties": {
        "language": { "enum": ["sql", "typescript", "javascript", "http", "yaml", "text"] },
        "code": { "type": "string", "maxLength": 8000 },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 3000 }
      }
    }
  }
}
