# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo
coverage/

# Generated consumer fixtures. tools/build-fixtures.ts is the tracked source of truth; its output
# embeds this repository's current commit as the fixture's policy lock, so any commit would
# immediately make a committed copy stale. tests/global-setup.ts regenerates it before each run.
tests/fixtures/consumer/

# Generated build evidence. Local paths and machine-specific digests; a real release writes evidence
# into its run directory rather than the repository root.
build-evidence.json

# Generated run directories and reports. A run directory holds raw tool output, which may contain
# material that must not be committed. Evidence *references* and digests belong in version control.
.hardening/runs/
.hardening/evidence/
runs/
*.report.json
report.md

# Local database and container state from the reference stack (Step 07)
supabase/.branches/
supabase/.temp/
examples/**/node_modules/
examples/**/.next/

# Credentials and local configuration. Anything that can authenticate is never committed.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.netrc
.npmrc.local
.pnpmrc.local

# Playwright artifacts. A test run writes screenshots, traces, and a last-run marker; none of it is
# source, and a committed trace can carry private page content.
examples/**/test-results/
examples/**/playwright-report/

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Python caches from helper scripts
__pycache__/
*.pyc

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
tools/bin/
