{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hardening.invalid/schemas/control.schema.json",
  "title": "Control definition",
  "description": "A repository-owned control definition. Definitions authored by an AI start as `review_status: draft`; only the owner records `owner_reviewed` with a reviewer and date.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "definition_version",
    "review_status",
    "title",
    "purpose",
    "applicability",
    "acceptance",
    "verification",
    "evidence_requirements",
    "limitations",
    "owner_role"
  ],
  "properties": {
    "schema_version": {
      "const": "control/v1"
    },
    "id": {
      "$ref": "#/$defs/controlId"
    },
    "definition_version": {
      "type": "integer",
      "minimum": 1
    },
    "review_status": {
      "enum": [
        "draft",
        "owner_reviewed"
      ]
    },
    "reviewed_by": {
      "type": "string",
      "maxLength": 200
    },
    "reviewed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule"
      ],
      "properties": {
        "rule": {
          "description": "A typed predicate over declared manifest features and environments. Never JavaScript, shell, or a general expression.",
          "enum": [
            "always",
            "when_feature_enabled",
            "when_any_feature_enabled",
            "when_environment",
            "when_all"
          ]
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/featureKey"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "environments": {
          "type": "array",
          "items": {
            "enum": [
              "local",
              "preview",
              "staging",
              "production"
            ]
          },
          "minItems": 1,
          "maxItems": 8
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rule": {
                "enum": [
                  "when_feature_enabled",
                  "when_any_feature_enabled",
                  "when_all"
                ]
              }
            },
            "required": [
              "rule"
            ]
          },
          "then": {
            "required": [
              "features"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "rule": {
                "const": "when_environment"
              }
            },
            "required": [
              "rule"
            ]
          },
          "then": {
            "required": [
              "environments"
            ]
          }
        }
      ]
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "maxItems": 32
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "description": "At least one real method or an explicit manual recipe. A control with no method cannot be selected by a profile.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "coverage"
        ],
        "properties": {
          "method": {
            "enum": [
              "schema_validation",
              "policy_consistency",
              "static_analysis",
              "secret_scan",
              "dependency_scan",
              "workflow_analysis",
              "authorization_test",
              "functional_test",
              "build_check",
              "client_asset_inspection",
              "live_http_check",
              "tls_check",
              "passive_scan",
              "manual_attestation",
              "quality_scan"
            ]
          },
          "recipe": {
            "type": "string",
            "maxLength": 200
          },
          "coverage": {
            "enum": [
              "automated",
              "mixed",
              "manual_only"
            ],
            "description": "`automated` checks run by the runner. `manual_only` is never satisfied by a scan."
          },
          "recipe_version": {
            "type": "string",
            "maxLength": 32
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          }
        }
      },
      "maxItems": 16
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "check_result",
              "manual_evidence",
              "configuration_record",
              "inventory"
            ]
          },
          "required_origin": {
            "enum": [
              "actual_tool",
              "manual_attestation"
            ]
          },
          "max_age_days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3650
          },
          "notes": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "maxItems": 16
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "maxItems": 32
    },
    "owner_role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "reassessment_triggers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "maxItems": 32
    },
    "standards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "framework",
          "relationship"
        ],
        "properties": {
          "framework": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "edition": {
            "type": "string",
            "maxLength": 100
          },
          "requirement": {
            "type": "string",
            "maxLength": 200
          },
          "relationship": {
            "enum": [
              "related_risk",
              "verified_coverage",
              "unverified_reference"
            ],
            "description": "`related_risk` is a taxonomy link. `verified_coverage` asserts the requirement was actually assessed."
          },
          "verified_by": {
            "type": "string",
            "maxLength": 200
          },
          "verified_at": {
            "$ref": "#/$defs/timestamp"
          },
          "notes": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "maxItems": 32
    },
    "extensions": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "description": "owner_reviewed requires a recorded reviewer and date.",
      "if": {
        "properties": {
          "review_status": {
            "const": "owner_reviewed"
          }
        },
        "required": [
          "review_status"
        ]
      },
      "then": {
        "required": [
          "reviewed_by",
          "reviewed_at"
        ]
      }
    }
  ],
  "$defs": {
    "controlId": {
      "type": "string",
      "pattern": "^(CTX|GOV|AGT|DEP|SEC|CI|CODE|QUAL|AUTH|AUTHZ|DATA|WEB|ABUSE|BIZ|DEPLOY|OPS|PRIV|REL|EXC)-[0-9]{2}$"
    },
    "featureKey": {
      "enum": [
        "accounts",
        "private_resources",
        "roles",
        "tenancy",
        "recovery",
        "payments",
        "webhooks",
        "uploads",
        "outbound_requests",
        "personal_data",
        "runtime_ai",
        "hosting",
        "interfaces",
        "environments",
        "persistent_storage"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    }
  }
}
