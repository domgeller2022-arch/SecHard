{
  "name": "sechard",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Versioned control catalogue, verification checks, and honest release evidence for applications built with AI coding tools",
  "license": "UNLICENSED",
  "license_note": "code_licence is TODO in 01-owner-decisions.md. No LICENSE file is created until the owner chooses one; UNLICENSED prevents accidental publication under a default licence.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.9.1",
  "bin": {
    "hardening": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "controls",
    "profiles",
    "policy"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "lint": "node tools/lint.mjs",
    "test": "vitest run --exclude \"tests/integration/**\" --exclude \"tests/scanners/**\" --exclude \"tests/example/**\"",
    "test:scanners": "vitest run tests/scanners",
    "test:example": "vitest run tests/example",
    "test:integration": "vitest run tests/integration",
    "hardening": "node dist/cli.js",
    "generate:matrix": "pnpm run build && node tools/generate-matrix.ts",
    "generate:status": "node tools/generate-status.mjs",
    "build:fixtures": "node tools/build-fixtures.ts",
    "fetch:tools": "node tools/fetch-tools.mjs",
    "generate:agent-rules": "pnpm run build && node tools/generate-agent-rules.ts",
    "review:changes": "node tools/review-changes.mjs",
    "inspect:build": "node tools/inspect-build.mjs",
    "live:check": "node tools/run-live-checks.mjs",
    "verify:completion": "node tools/verify-completion.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "vite": "8.3.1"
  }
}
