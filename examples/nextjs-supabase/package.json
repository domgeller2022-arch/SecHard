{
  "name": "example-nextjs-supabase",
  "version": "0.1.0",
  "private": true,
  "description": "Reference application: a small private-notes app used to exercise the hardening controls.",
  "type": "module",
  "scripts": {
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "supabase": "supabase",
