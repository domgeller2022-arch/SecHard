# Local development environment for the reference application.
#
# Written by `pnpm run env:sync`, which reads the running local stack's values. `.env.local` is
# gitignored; this file documents the shape.
#
# The publishable key is intended for the browser. It identifies no user on its own; user identity
# comes from a session. The secret key is deliberately absent: nothing in this application should
# use a credential that bypasses row-level security, and the seed uses a privileged database
# connection instead of the application's own client.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_LOCAL_VALUE
