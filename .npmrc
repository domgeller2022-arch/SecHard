# npm configuration.
#
# pnpm is the pinned package manager (`packageManager` in package.json), and pnpm 12.9.1 does NOT
# read its settings from this file. The verified pnpm settings — engine strictness, exact saving,
# the release-age delay, and the install-script allowlist — live in `pnpm-workspace.yaml`.
#
# This file exists so that an accidental `npm install` still behaves safely. It is NOT the
# mechanism that enforces the dependency policy.

# npm: do not run dependency lifecycle scripts implicitly. pnpm ignores this key and uses
# `allowBuilds` in pnpm-workspace.yaml instead, which fails the install on an unapproved hook.
ignore-scripts=true

# npm: exact versions only.
save-exact=true

# npm: refuse to install when the running Node does not satisfy `engines`. (pnpm uses
# `engineStrict` in pnpm-workspace.yaml.)
engine-strict=true
