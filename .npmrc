# Initial installation policy. UNVERIFIED against a pinned pnpm runtime: installing package
# runtimes requires agent_may_install_runtimes, which is still TODO in 01-owner-decisions.md.
# Step 06 selects a pnpm release that supports the intended strictness and tests each setting.

# Refuse to install when the running Node does not satisfy `engines`. Without this, npm and pnpm
# only warn, and an unsupported runtime looks like a supported one.
engine-strict=true

# Exact versions only. A caret range turns a lockfile update into a silent policy change.
save-exact=true

# Do not let a package's install scripts run implicitly.
ignore-scripts=true

# No implicit peer dependency resolution and no silent transitive upgrades.
strict-peer-dependencies=true
auto-install-peers=false
resolution-mode=highest

# Deliberately NOT set here:
#   minimum-release-age       Step 06 selects and tests the exact 10080-minute (7-day) policy.
#   only-built-dependencies   Step 06 decides the reviewed build-hook allowlist.
#   registry                  Step 06 records reviewed registries.
